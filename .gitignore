# Local environment with real credentials - never commit
.env

# YOUR LIBRARY IS NEVER COMMITTED. ./library is where the compose file mounts
# your game files by default; nothing in it belongs in git, and a repository
# that could carry someone's ROMs by one `git add -A` is a repository that one
# day will. The directory itself stays so the default mount has somewhere to be.
library/*
!library/.gitkeep

# Your RomM configuration, copied from config/config.example.yml. Kept out of
# git so editing it never blocks update.sh, which refuses a dirty checkout.
config/config.yml
