# RomM + Traefik + Let's Encrypt - Environment Variables
# Copy this file to `.env` and fill in each value before `docker compose up`.
# `.env` is gitignored - never commit real credential values.
#
# Image versions are NOT set here. The tested tag + sha256 digest lives in the
# compose file's `x-images` block, so `git pull` delivers the versions this
# repository has tested. To pin differently, uncomment:
# ROMM_IMAGE_TAG=rommapp/romm:5.3.1@sha256:...
# ROMM_MARIADB_IMAGE_TAG=mariadb:11.4@sha256:...
# TRAEFIK_IMAGE_TAG=traefik:3.7@sha256:...

# Traefik Variables
# Log level: DEBUG, INFO, WARN, ERROR. Default: WARN.
# TRAEFIK_LOG_LEVEL=WARN

# Timeouts on Traefik's HTTPS entry point. Unset, Traefik's own defaults
# apply (shown here). Raise the read timeout for slow uploads; 0s means no
# timeout at all.
# TRAEFIK_READ_TIMEOUT=60s
# TRAEFIK_WRITE_TIMEOUT=0s
# TRAEFIK_IDLE_TIMEOUT=180s

# The email address used by Let's Encrypt for renewal notices. REQUIRED.
TRAEFIK_ACME_EMAIL=admin@example.com

# The hostname of the Traefik dashboard (DNS must point at this server). REQUIRED.
TRAEFIK_HOSTNAME=traefik.romm.example.com

# Basic auth for the Traefik dashboard. REQUIRED. Generate your own:
#     docker run --rm httpd:2.4 htpasswd -nbB traefikadmin your-password
# Escape every `$` in the hash as `$$` when pasting into this file.
TRAEFIK_BASIC_AUTH=

# RomM Variables
# The hostname RomM is served on (DNS must point at this server). REQUIRED.
ROMM_HOSTNAME=romm.example.com

# Database credentials. REQUIRED - generate each with:
#     openssl rand -base64 24 | tr -d '/+=' | head -c 32
# ROMM_DB_USER=rommdbuser
ROMM_DB_PASSWORD=
ROMM_DB_ADMIN_PASSWORD=

# Signs RomM's sessions. REQUIRED - generate with:
#     openssl rand -hex 32
ROMM_AUTH_SECRET_KEY=

# Where your game library lives on this host. Default: ./library next to the
# compose file (kept out of git). See https://docs.romm.app for the layout
# RomM expects - one folder per platform.
# ROMM_LIBRARY_PATH=/srv/games

# Metadata providers - all optional. RomM starts and scans without any of them
# and gets better with each one configured. Where to get each key:
# https://docs.romm.app/latest/Getting-Started/Metadata-Providers/
# ROMM_SCREENSCRAPER_USER=
# ROMM_SCREENSCRAPER_PASSWORD=
# ROMM_RETROACHIEVEMENTS_API_KEY=
# ROMM_STEAMGRIDDB_API_KEY=
# ROMM_IGDB_CLIENT_ID=
# ROMM_IGDB_CLIENT_SECRET=
# ROMM_MOBYGAMES_API_KEY=
# ROMM_HASHEOUS_API_ENABLED=true

# Scanning and serving. Defaults shown.
# ROMM_SCAN_WORKERS=4
# ROMM_WEB_SERVER_CONCURRENCY=4
# ROMM_TIMEZONE=UTC

# Backups. Defaults shown.
# BACKUP_INIT_SLEEP=30m
# BACKUP_INTERVAL=24h
# MARIADB_BACKUP_PRUNE_DAYS=7
# DATA_BACKUP_PRUNE_DAYS=7
# MARIADB_BACKUPS_PATH=/srv/romm-mariadb/backups
# DATA_BACKUPS_PATH=/srv/romm-application-data/backups
# MARIADB_BACKUP_NAME=romm-mariadb-backup
# DATA_BACKUP_NAME=romm-application-data-backup

# Resource limits (defaults shown). Override any of them here and the override
# survives every git pull. Raise a limit if a service is OOM-killed
# (docker inspect shows OOMKilled=true).
# ROMM_MEMORY_LIMIT=2g
# ROMM_CPU_LIMIT=2.0
# ROMM_MARIADB_MEMORY_LIMIT=1g
# TRAEFIK_MEMORY_LIMIT=256m
