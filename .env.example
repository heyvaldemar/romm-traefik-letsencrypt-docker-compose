# Copy to .env and fill in every value. .env is gitignored.
# Image versions are pinned in the compose file; set a *_IMAGE_TAG here
# only to deliberately run something other than what was tested.

TRAEFIK_IMAGE_TAG=
TRAEFIK_LOG_LEVEL=
TRAEFIK_ACME_EMAIL=
TRAEFIK_HOSTNAME=
TRAEFIK_BASIC_AUTH=change_me_before_first_start
ROMM_MARIADB_IMAGE_TAG=
ROMM_REDIS_IMAGE_TAG=
ROMM_IMAGE_TAG=
ROMM_DB_NAME=
ROMM_DB_USER=
ROMM_DB_PASSWORD=change_me_before_first_start
ROMM_DB_ADMIN_PASSWORD=change_me_before_first_start
ROMM_HOSTNAME=
ROMM_AUTH_SECRET_KEY=change_me_before_first_start
ROMM_IGDB_CLIENT_ID=change_me_before_first_start
ROMM_IGDB_CLIENT_SECRET=change_me_before_first_start
ROMM_MOBYGAMES_API_KEY=change_me_before_first_start
ROMM_STEAMGRIDDB_API_KEY=change_me_before_first_start
ROMM_SCAN_TIMEOUT=
ROMM_SCHEDULED_RESCAN_CRON=
ROMM_SCHEDULED_UPDATE_SWITCH_TITLEDB_CRON=
ROMM_SCHEDULED_UPDATE_MAME_XML_CRON=
ROMM_SERVER_TIMEZONE=
BACKUP_INIT_SLEEP=
